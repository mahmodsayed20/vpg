rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'drfayz20@gmail.com';
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // Categories — anyone logged in can read, only admin can write
    match /categories/{id} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }

    // Prompt items — anyone logged in can read, only admin can write
    match /promptItems/{id} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
