rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'drfayz20@gmail.com';
    }

    // Categories — anyone can read, only admin can write
    match /categories/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Prompt items — anyone can read, only admin can write
    match /promptItems/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
