rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone logged in = admin (we control who logs in via Firebase Console)
    function isAdmin() {
      return request.auth != null;
    }

    match /categories/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /promptItems/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
